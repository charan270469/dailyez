# DailyEz environment configuration. Copy this file to .env for local use.
# Blank values require deployment-specific input; included values match code defaults.

# OAuth client identifier used for Gmail sign-in; create it in Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
# OAuth client value used for Gmail sign-in; copy it from the same Google Cloud OAuth client.
GOOGLE_CLIENT_SECRET=
# Callback URL used after Gmail sign-in; register the same URL in the Google Cloud OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Port used by the backend HTTP server; choose an available port for your deployment.
PORT=3001
# Frontend origin allowed for browser requests and OAuth redirects; set this to your deployed frontend URL.
FRONTEND_URL=http://localhost:3000

# MongoDB connection URI used by the backend; copy it from MongoDB Atlas > Connect > Drivers or your database provider.
MONGODB_URI=

# Value used to authorize Groq model requests; create it in Groq Console > API Keys.
GROQ_API_KEY=
# Model used to match messages to signals; choose an available model in Groq Console.
GROQ_MATCH_MODEL=openai/gpt-oss-20b
# Model used to verify lower-confidence matches; choose an available model in Groq Console.
GROQ_VERIFY_MODEL=openai/gpt-oss-120b
# Model used to extract message facts; choose an available model in Groq Console.
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
# Model used to route voice commands; choose an available model in Groq Console.
GROQ_ROUTE_MODEL=openai/gpt-oss-20b
# Model used to summarize conversations; choose an available model in Groq Console.
GROQ_SUMMARIZE_MODEL=openai/gpt-oss-120b
# Model used to answer grounded questions; choose an available model in Groq Console.
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
# Output-token cap for message matching; leave blank to use the built-in default.
GROQ_MATCH_MAX_TOKENS=800
# Output-token cap for match verification; leave blank to use the built-in default.
GROQ_VERIFY_MAX_TOKENS=800
# Output-token cap for fact extraction; leave blank to use the built-in default.
GROQ_EXTRACT_MAX_TOKENS=800
# Output-token cap for voice-command routing; leave blank to use the built-in default.
GROQ_ROUTE_MAX_TOKENS=800
# Output-token cap for conversation summaries; leave blank to use the built-in default.
GROQ_SUMMARIZE_MAX_TOKENS=1024
# Output-token cap for grounded answers; leave blank to use the built-in default.
GROQ_ANSWER_MAX_TOKENS=1024
# Maximum message characters sent to matching; leave blank to use the built-in default.
GROQ_MATCH_CONTENT_CHAR_LIMIT=4000
# Maximum message characters sent to verification; leave blank to use the built-in default.
GROQ_VERIFY_CONTENT_CHAR_LIMIT=4000
# Maximum message characters sent to extraction; leave blank to use the built-in default.
GROQ_EXTRACT_CONTENT_CHAR_LIMIT=4000
# Maximum number of messages included in a summary; leave blank to use the built-in default.
GROQ_SUMMARIZE_MAX=100
# Maximum matching requests per minute; leave blank to use the built-in default.
GROQ_MATCH_RPM_LIMIT=4
# Shared daily request cap for Groq models; leave blank to use the built-in default.
GROQ_DAILY_LIMIT=1000
# Optional daily cap for the matching GPT-OSS model; set a deployment-appropriate limit or leave blank.
GROQ_DAILY_LIMIT_GPT_OSS_20B=

# Value used for PDF parsing requests; create it in Google AI Studio > API keys.
GEMINI_API_KEY=
# Daily request budget shown for PDF parsing; leave blank to use the built-in default.
GEMINI_DAILY_LIMIT=1500

# Gmail message history uses a fixed 30-day window; no environment setting is needed.

# Number of days of WhatsApp history persisted after pairing or resync; leave blank to use the built-in default.
WHATSAPP_HISTORY_WINDOW_DAYS=3
# Internal WhatsApp library log verbosity; choose silent, error, or debug.
WHATSAPP_LOG_LEVEL=silent

# Local text-to-speech voice identifier; choose an installed voice supported by Kokoro.
KOKORO_VOICE=af_heart

# Set to true to disable Vite hot reload and file watching; leave blank for normal development.
DISABLE_HMR=
