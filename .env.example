# DailyEz — environment template. Copy to .env: Copy-Item .env.example .env
# Values left blank must be filled in; values already filled are safe code defaults.

# ── Google OAuth (Gmail) — get from Google Cloud Console > APIs & Services > Credentials (OAuth client ID, Web app) with Gmail API enabled ──
GOOGLE_CLIENT_ID= # OAuth client ID for Gmail login
GOOGLE_CLIENT_SECRET= # OAuth client secret for Gmail login
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback # Must match Authorized redirect URI in Google Cloud (defaults in server/auth.js)

# ── App URLs / ports ──
PORT=3001 # Backend Express port (defaults in server/index.js)
FRONTEND_URL=http://localhost:3000 # Where OAuth redirects after login + CORS origin (defaults in server/authRoutes.js, server/index.js)

# ── MongoDB — get from MongoDB Atlas (Connect > connection string) or local mongod ──
MONGODB_URI= # MongoDB connection string, required (read in server/db.js)

# ── Groq — get from https://console.groq.com/keys (LLM matching, summaries, voice agent) ──
GROQ_API_KEY= # Groq API key, required for all model calls
GROQ_MATCH_MODEL=openai/gpt-oss-20b # Model for signal matching (server/agents/matchSignal.js)
GROQ_VERIFY_MODEL=openai/gpt-oss-120b # Model for verify/critique pass (server/agents/signalMatching.js)
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b # Model for fact extraction (server/agents/extractionAgent.js)
GROQ_ROUTE_MODEL=openai/gpt-oss-20b # Model for voice-command intent routing
GROQ_SUMMARIZE_MODEL=openai/gpt-oss-120b # Model for conversation/message summaries
GROQ_ANSWER_MODEL=openai/gpt-oss-120b # Model for grounded Q&A answers (server/agents/generalAnswer.js)
GROQ_MATCH_MAX_TOKENS=800 # Max output tokens for match pass
GROQ_VERIFY_MAX_TOKENS=800 # Max output tokens for verify pass
GROQ_EXTRACT_MAX_TOKENS=800 # Max output tokens for extraction pass
GROQ_ROUTE_MAX_TOKENS=800 # Max output tokens for route pass
GROQ_SUMMARIZE_MAX_TOKENS=1024 # Max output tokens for summaries
GROQ_ANSWER_MAX_TOKENS=1024 # Max output tokens for answers
GROQ_MATCH_CONTENT_CHAR_LIMIT=4000 # Max message chars sent to match prompt
GROQ_VERIFY_CONTENT_CHAR_LIMIT=4000 # Max message chars sent to verify prompt
GROQ_EXTRACT_CONTENT_CHAR_LIMIT=4000 # Max message chars sent to extraction prompt
GROQ_SUMMARIZE_MAX=100 # Hard cap on emails covered per summary
GROQ_MATCH_RPM_LIMIT=4 # Min pacing between match calls (requests per minute)
GROQ_DAILY_LIMIT=1000 # Fallback daily request cap per model (server/agents/groqBudget.js)
# GROQ_DAILY_LIMIT_GPT_OSS_20B= # Optional per-model cap; suffix must match model name (e.g. _GPT_OSS_20B matches openai/gpt-oss-20b)

# ── Gemini — get from https://aistudio.google.com/apikey (PDF attachment parsing only) ──
GEMINI_API_KEY= # Gemini API key for PDF parsing (server/agents/parsePdfAttachment.js)
GEMINI_DAILY_LIMIT=1500 # Shared-key daily request budget for visibility (server/agents/geminiBudget.js)

# ── Gmail ingest ──
# Gmail fetch and retention window is fixed at 30 days (server/gmail/fetchMessages.js)

# ── WhatsApp (Baileys, no API key — session stored gitignored under server/whatsapp/auth_session/) ──
WHATSAPP_HISTORY_WINDOW_DAYS=3 # Days of history persisted on pairing/resync (server/whatsapp/connection.js)
WHATSAPP_LOG_LEVEL=silent # Baileys internal log level: silent/error/debug (server/whatsapp/connection.js)

# ── Voice reply TTS (local ONNX Kokoro, no key) ──
KOKORO_VOICE=af_heart # TTS voice id (server/ttsKokoro.js)

# ── Vite dev server only ──
# DISABLE_HMR= # Set to true to disable HMR/file-watching (AI Studio agent edits); leave blank for normal dev
