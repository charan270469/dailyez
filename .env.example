# ── Google OAuth2 (Gmail) ──────────────────────────────────────────────────────
# Create credentials at Google Cloud Console > APIs & Services > Credentials
# (OAuth client ID, type "Web application"). Enable the Gmail API first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match the "Authorized redirect URIs" entry in Google Cloud Console.
# Defaults to http://localhost:3001/auth/google/callback if unset.
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Where the frontend is served — used only to redirect the browser back after a
# successful Google login. Defaults to http://localhost:3000 if unset.
FRONTEND_URL=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Connection string for a local or Atlas MongoDB instance (mongodb:// or mongodb+srv://).
# Required — the app cannot read/write messages or signals without it.
MONGODB_URI=

# ── Groq (LLM matching + voice agent) ─────────────────────────────────────────
# API key from https://console.groq.com — powers signal matching, email summaries,
# voice intent routing, and Whisper transcription.
GROQ_API_KEY=

# Optional overrides for which Groq model each feature uses
# (defaults: matching/routing = openai/gpt-oss-20b, summarizer/answers = openai/gpt-oss-120b).
# GROQ_MATCH_MODEL=openai/gpt-oss-20b
# GROQ_ROUTE_MODEL=openai/gpt-oss-20b
# GROQ_SUMMARIZE_MODEL=openai/gpt-oss-120b
# GROQ_ANSWER_MODEL=openai/gpt-oss-120b

# Optional hard cap on how many emails a single summary covers (default 100).
# GROQ_SUMMARIZE_MAX=100

# ── Optional / not-yet-implemented ─────────────────────────────────────────────
# Backend port — pinned to 3001 (the Vite frontend always runs on port 3000)
PORT=3001

# Only used to report Discord as "connected" in the UI. The Discord integration
# itself is not implemented yet.
# DISCORD_BOT_TOKEN=

# Baileys (WhatsApp) log verbosity — 'silent' | 'error' | 'warn' | 'info' | 'debug'.
# Defaults to 'silent'.
# WHATSAPP_LOG_LEVEL=silent
